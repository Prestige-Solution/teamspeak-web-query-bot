{
    "name": "prestige-solution/teamspeak-web-query-bot",
    "type": "project",
    "description": "Teamspeak Web Query Bot",
    "keywords": ["teamspeak3","query","teamspeak3 bot","ts", "teamspeak","server","management","interface","api"],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/Prestige-Solution/teamspeak-web-query-bot/issues"
    },
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-gd": "*",
        "awobaz/compoships": "^3.0",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "prestige-solution/ts-x-php-framework": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.4",
        "phpunit/phpunit": "^13.0",
        "nunomaduro/collision": "^8.1",
        "friendsofphp/php-cs-fixer": "^3.69"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "code-style": [
            "\"vendor/bin/php-cs-fixer\" fix --config .php-cs-fixer.php --diff"
        ],
        "check-code-style-pint": [
            "\"vendor/bin/pint\" --test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
